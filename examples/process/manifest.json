{
  "id": "com.example.shout-process",
  "name": "Shout (compiled)",
  "version": "0.1.0",
  "minAppVersion": "1.6.1",
  "runtime": "process",
  "entrypoints": {
    "linux": "bin/linux/plugin",
    "macos": "bin/macos/plugin",
    "windows": {
      "x64": "bin\\windows-x64\\plugin.exe",
      "arm64": "bin\\windows-arm64\\plugin.exe"
    }
  },
  "permissions": [
    "document.read",
    "ui.contextMenu"
  ]
}
